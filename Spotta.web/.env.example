# Copia este archivo como .env.development y rellena los valores.
# La clave publicable no es secreta: está pensada para ir en un cliente.
# La de servicio (sb_secret_...) no va aquí nunca: sólo la conoce la API.
VITE_API_URL=http://localhost:5240
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
