# Copia este archivo como .env y rellena los valores.
#
# En un dispositivo real, localhost es el propio teléfono:
# pon la IP de tu máquina en la red local.
EXPO_PUBLIC_API_URL=http://localhost:5240

# La clave publicable no es secreta: está pensada para ir en un cliente.
# La de servicio (sb_secret_...) no va aquí nunca: sólo la conoce la API.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
